{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RefinementManifest",
  "description": "Manifest written by spawn-refinement-team to ${SESSION_ROOT}/refinement_manifest.json",
  "type": "object",
  "required": ["prd_path", "refinement_dir", "all_success", "cycles_requested", "cycles_completed", "max_turns_per_worker", "ac_shape_smells", "tickets", "workers", "completed_at"],
  "additionalProperties": false,
  "properties": {
    "prd_path": { "type": "string", "minLength": 1 },
    "refinement_dir": { "type": "string", "minLength": 1 },
    "all_success": { "type": "boolean" },
    "cycles_requested": { "type": "integer", "minimum": 1 },
    "cycles_completed": { "type": "integer", "minimum": 0 },
    "max_turns_per_worker": { "type": "integer", "minimum": 0 },
    "ac_shape_smells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac_id"],
        "properties": {
          "ac_id": { "type": "string", "minLength": 1 },
          "headline": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "targets": { "type": "array", "items": { "type": "string" } },
          "repeated_predicate": { "type": "string" },
          "ticket_ids": { "type": "array", "items": { "type": "string" } },
          "source_worker": { "type": "string" },
          "source_file": { "type": "string" }
        }
      }
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source_ac_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "source_ac_ids": { "type": "array", "items": { "type": "string" } },
          "source_prd": { "type": "string" },
          "source_section": { "type": "string" },
          "mapped_requirements": { "type": "array", "items": { "type": "string" } },
          "acceptance_test": { "type": "string" },
          "justification": { "type": "string" },
          "source_worker": { "type": "string" },
          "source_file": { "type": "string" }
        }
      }
    },
    "ticket_quality_warnings": {
      "type": "array",
      "description": "R-TAQ-7: per-ticket quality warnings populated by R-TAQ-1 (analyst-side verification) and R-TAQ-2 (post-decomp audit)",
      "items": {
        "type": "object",
        "required": ["ticket_id", "defect_class", "evidence"],
        "additionalProperties": false,
        "properties": {
          "ticket_id": {
            "type": "string",
            "minLength": 1,
            "description": "Ticket identifier (e.g. hash or Linear ID); operator-facing alias: `ticket`"
          },
          "defect_class": {
            "type": "string",
            "minLength": 1,
            "description": "Defect class string (e.g. 'path-drift', 'hallucinated-premise'); operator-facing alias: `class`"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable description of what triggered the warning"
          },
          "source": {
            "type": "string",
            "enum": ["analyst", "post-decomp"],
            "description": "AC-TAQ-07-2: producer category — analyst-side (R-TAQ-1) or post-decomposition audit (R-TAQ-2)"
          },
          "file_line": {
            "type": ["string", "null"],
            "description": "AC-TAQ-07-2: source citation pointer in `path:line` form, or null when unavailable"
          },
          "analyst": {
            "type": "string",
            "description": "Analyst role id that authored the citation (analyst-sourced warnings only)"
          },
          "cycle": {
            "type": "integer",
            "minimum": 1,
            "description": "Refinement cycle the citation was authored in (analyst-sourced warnings only)"
          }
        }
      }
    },
    "decomposition_quality_flags": {
      "type": "array",
      "description": "R-ORSR-5: per-ticket decomposition-quality flags raised by the post-decomposition audit",
      "items": {
        "type": "object",
        "required": ["ticket_id", "reason", "evidence", "action", "suggested_reframe"],
        "additionalProperties": false,
        "properties": {
          "ticket_id": { "type": "string", "minLength": 1 },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the ticket was flagged; `large_tier` or `open_ended_derivation` today. Deliberately NOT an enum: `additionalProperties: false` already fails the WHOLE manifest, and a mirrored value list would do the same the day detectDecompositionQualityFlags grows a reason. The DecompositionQualityFlag union is the one place the vocabulary lives."
          },
          "evidence": { "type": "string", "minLength": 1 },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "Recommended remedy; `bounded_reframe` or `pre_split` today. Not an enum, same reason as `reason`."
          },
          "suggested_reframe": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "success", "output_file", "exists", "log_file", "cycle"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "success": { "type": "boolean" },
          "output_file": { "type": "string" },
          "exists": { "type": "boolean" },
          "log_file": { "type": "string" },
          "cycle": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
